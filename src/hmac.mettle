// raize_auth/hmac: HMAC-SHA256 (RFC 2104), PBKDF2-HMAC-SHA256 (RFC 8018) and
// constant-time comparison.
// thread: pure functions over caller memory; a RaHmac belongs to one thread at a time.

import "std/mem";
import "status";
import "sha256";

/// A keyed HMAC-SHA256 state: the inner and outer hashes after the padded key.
/// Copy it by value to MAC many messages under one key without re-keying.
export struct RaHmac {
  inner: RaSha256;
  outer: RaSha256;
}

/// Keys an HMAC-SHA256 state.
///
/// in:      h        the state to key
///          key, klen  the key (any length; longer than 64 bytes is hashed first)
/// returns: nothing
/// owns:    reads key; h keeps derived pads, not the key pointer. Zero h when done
///          if the key is secret
/// thread:  any (one thread per state)
/// example:
///   var h: RaHmac; ra_hmac_init(&h, &secret[0], 32);
export fn ra_hmac_init(h: RaHmac*, key: uint8*, klen: int64) {
  var k: uint8[64];
  memset(&k[0], 0, 64);
  if (klen > 64) {
    ra_sha256(key, klen, &k[0]);
  } else if (klen > 0) {
    memcpy(&k[0], key, klen);
  }
  var pad: uint8[64];
  var i: int64 = 0;
  while (i < 64) {
    pad[i] = k[i] ^ (uint8)0x36;
    i = i + 1;
  }
  ra_sha256_init(&h->inner);
  ra_sha256_update(&h->inner, &pad[0], 64);
  i = 0;
  while (i < 64) {
    pad[i] = k[i] ^ (uint8)0x5c;
    i = i + 1;
  }
  ra_sha256_init(&h->outer);
  ra_sha256_update(&h->outer, &pad[0], 64);
  memset(&k[0], 0, 64);
  memset(&pad[0], 0, 64);
}

/// Feeds message bytes into a keyed HMAC state.
///
/// in:      h        a state from ra_hmac_init
///          p, n     message bytes
/// returns: nothing
/// owns:    reads p only
/// thread:  any (one thread per state)
/// example:
///   ra_hmac_update(&h, msg.chars, (int64)msg.length);
export fn ra_hmac_update(h: RaHmac*, p: uint8*, n: int64) {
  ra_sha256_update(&h->inner, p, n);
}

/// Finishes an HMAC and writes the 32-byte tag.
///
/// in:      h        a fed state (spent afterwards)
///          out      room for 32 bytes
/// returns: nothing
/// owns:    writes out
/// thread:  any (one thread per state)
/// example:
///   var tag: uint8[32]; ra_hmac_final(&h, &tag[0]);
export fn ra_hmac_final(h: RaHmac*, out: uint8*) {
  var d: uint8[32];
  ra_sha256_final(&h->inner, &d[0]);
  ra_sha256_update(&h->outer, &d[0], 32);
  ra_sha256_final(&h->outer, out);
}

/// HMAC-SHA256 in one call.
///
/// in:      key, klen  the key
///          msg, mlen  the message
///          out        room for 32 bytes
/// returns: nothing
/// owns:    writes out; no allocation
/// thread:  any
/// example:
///   var tag: uint8[32]; ra_hmac_sha256(&k[0], 32, body.chars, (int64)body.length, &tag[0]);
export fn ra_hmac_sha256(key: uint8*, klen: int64, msg: uint8*, mlen: int64, out: uint8*) {
  var h: RaHmac;
  ra_hmac_init(&h, key, klen);
  ra_hmac_update(&h, msg, mlen);
  ra_hmac_final(&h, out);
}

/// PBKDF2-HMAC-SHA256 key derivation.
///
/// in:      pw, pwlen      the password bytes
///          salt, saltlen  the salt (16+ random bytes in real use)
///          iterations     >= 1
///          out, dklen     derived key buffer and its length (1..1024)
/// returns: RA_OK, or RA_E_USAGE for iterations < 1 or a bad dklen
/// owns:    writes out; no allocation
/// thread:  any; CPU-bound (iterations * 2 SHA-256 blocks per 32 output bytes)
/// example:
///   var dk: uint8[32]; ra_pbkdf2_sha256(pw.chars, (int64)pw.length, &salt[0], 16, 600000, &dk[0], 32);
export fn ra_pbkdf2_sha256(pw: uint8*, pwlen: int64, salt: uint8*, saltlen: int64, iterations: int64, out: uint8*, dklen: int64) -> int32 {
  if (iterations < 1 || dklen < 1 || dklen > 1024) { return RA_E_USAGE; }
  var base: RaHmac;
  ra_hmac_init(&base, pw, pwlen);
  var block: int64 = 1;
  var done: int64 = 0;
  while (done < dklen) {
    var h: RaHmac = base;
    ra_hmac_update(&h, salt, saltlen);
    var ctr: uint8[4];
    ctr[0] = (uint8)((block >> 24) & 255);
    ctr[1] = (uint8)((block >> 16) & 255);
    ctr[2] = (uint8)((block >> 8) & 255);
    ctr[3] = (uint8)(block & 255);
    ra_hmac_update(&h, &ctr[0], 4);
    var u: uint8[32];
    ra_hmac_final(&h, &u[0]);
    var t: uint8[32];
    memcpy(&t[0], &u[0], 32);
    var it: int64 = 1;
    while (it < iterations) {
      var hj: RaHmac = base;
      ra_hmac_update(&hj, &u[0], 32);
      ra_hmac_final(&hj, &u[0]);
      var j: int64 = 0;
      while (j < 32) {
        t[j] = t[j] ^ u[j];
        j = j + 1;
      }
      it = it + 1;
    }
    var take: int64 = dklen - done;
    if (take > 32) { take = 32; }
    memcpy(&out[done], &t[0], take);
    done = done + take;
    block = block + 1;
  }
  memset((rawptr)&base, 0, sizeof(RaHmac));
  return RA_OK;
}

/// Compares two byte ranges in time that depends only on n, not on the contents.
///
/// in:      a, b     the ranges
///          n        their common length
/// returns: true when equal
/// owns:    reads only
/// thread:  any
/// example:
///   if (!ra_ct_equal(&want[0], &got[0], 32)) { return RA_E_MISMATCH; }
export fn ra_ct_equal(a: uint8*, b: uint8*, n: int64) -> bool {
  var diff: uint32 = 0;
  var i: int64 = 0;
  while (i < n) {
    diff = diff | ((uint32)a[i] ^ (uint32)b[i]);
    i = i + 1;
  }
  return diff == (uint32)0;
}

/// Constant-time string comparison (time depends on the lengths only).
///
/// in:      a, b     the strings; a length difference returns false at once
/// returns: true when equal
/// owns:    reads only
/// thread:  any
/// example:
///   if (!ra_ct_equal_str(presented, expected)) { return RA_E_MISMATCH; }
export fn ra_ct_equal_str(a: string, b: string) -> bool {
  if (a.length != b.length) { return false; }
  return ra_ct_equal(a.chars, b.chars, (int64)a.length);
}

fn rah_hex_is(d: uint8*, n: int64, want: string) -> bool {
  var hex: uint8[256];
  var m: int64 = ra_hex_encode(d, n, &hex[0]);
  if ((uint64)m != want.length) { return false; }
  return memcmp(&hex[0], want.chars, m) == 0;
}

fn rah_check(key: uint8*, klen: int64, msg: string, want: string) -> bool {
  var tag: uint8[32];
  ra_hmac_sha256(key, klen, msg.chars, (int64)msg.length, &tag[0]);
  return rah_hex_is(&tag[0], (int64)want.length / 2, want);
}

@test fn t_ra_hmac_rfc4231() -> int32 {
  var k: uint8[131];
  memset(&k[0], 0x0b, 20);
  if (!rah_check(&k[0], 20, "Hi There", "b0344c61d8db38535ca8afceaf0bf12b881dc200c9833da726e9376c2e32cff7")) { return 1; }
  var jefe: string = "Jefe";
  if (!rah_check(jefe.chars, 4, "what do ya want for nothing?", "5bdcc146bf60754e6a042426089575c75a003f089d2739839dec58b964ec3843")) { return 2; }
  var dd: uint8[50];
  memset(&k[0], 0xaa, 131);
  memset(&dd[0], 0xdd, 50);
  var tag: uint8[32];
  ra_hmac_sha256(&k[0], 20, &dd[0], 50, &tag[0]);
  if (!rah_hex_is(&tag[0], 32, "773ea91e36800e46854db8ebd09181a72959098b3ef8c122d9635514ced565fe")) { return 3; }
  var k4: uint8[25];
  for i in 0..25 { k4[i] = (uint8)(i + 1); }
  memset(&dd[0], 0xcd, 50);
  ra_hmac_sha256(&k4[0], 25, &dd[0], 50, &tag[0]);
  if (!rah_hex_is(&tag[0], 32, "82558a389a443c0ea4cc819899f2083a85f0faa3e578f8077a2e3ff46729665b")) { return 4; }
  var k5: uint8[20];
  memset(&k5[0], 0x0c, 20);
  if (!rah_check(&k5[0], 20, "Test With Truncation", "a3b6167473100ee06e0c796c2955552b")) { return 5; }
  if (!rah_check(&k[0], 131, "Test Using Larger Than Block-Size Key - Hash Key First", "60e431591ee0b67f0d8a26aacbf5b77f8e0bc6213728c5140546040f0ee37f54")) { return 6; }
  if (!rah_check(&k[0], 131, "This is a test using a larger than block-size key and a larger than block-size data. The key needs to be hashed before being used by the HMAC algorithm.", "9b09ffa71b942fcb27635fbcd5b0e944bfdc63644f0713938a7f51535c3a35e2")) { return 7; }
  return 0;
}

fn rah_pbkdf2_is(pw: string, salt: string, c: int64, dklen: int64, want: string) -> bool {
  var dk: uint8[64];
  if (ra_pbkdf2_sha256(pw.chars, (int64)pw.length, salt.chars, (int64)salt.length, c, &dk[0], dklen) != RA_OK) { return false; }
  return rah_hex_is(&dk[0], dklen, want);
}

@test fn t_ra_pbkdf2_short() -> int32 {
  if (!rah_pbkdf2_is("password", "salt", 1, 32, "120fb6cffcf8b32c43e7225256c4f837a86548c92ccc35480805987cb70be17b")) { return 1; }
  if (!rah_pbkdf2_is("password", "salt", 2, 32, "ae4d0c95af6b46d32d0adff928f06dd02a303f8ef3c251dfd6e2d85a95474c43")) { return 2; }
  // RFC 7914 §11, first PBKDF2-HMAC-SHA256 vector (two output blocks).
  if (!rah_pbkdf2_is("passwd", "salt", 1, 64, "55ac046e56e3089fec1691c22544b605f94185216dde0465e68b9d57c20dacbc49ca9cccf179b645991664b39d77ef317c71b845b1e30bd509112041d3a19783")) { return 3; }
  var dk: uint8[4];
  if (ra_pbkdf2_sha256(dk, 0, dk, 0, 0, &dk[0], 4) != RA_E_USAGE) { return 4; }
  return 0;
}

@test fn t_ra_ct_equal() -> int32 {
  if (!ra_ct_equal_str("abc", "abc")) { return 1; }
  if (ra_ct_equal_str("abc", "abd")) { return 2; }
  if (ra_ct_equal_str("abc", "ab")) { return 3; }
  return 0;
}
