// raize_auth/password: PBKDF2-HMAC-SHA256 password hashes in a self-describing
// string, verified in constant time.
// thread: pure functions over caller memory; safe on any thread. Hashing is
// CPU-bound by design (about 1.2 M SHA-256 blocks at the default count).
//
// Format:  pbkdf2-sha256$<iterations>$<salt, base64url>$<32-byte key, base64url>
// e.g.     pbkdf2-sha256$600000$q2l0c2FsdHNhbHQ$Xb3...  (at most 100 bytes)
//
// Default iterations: 600 000, the OWASP Password Storage Cheat Sheet figure
// for PBKDF2-HMAC-SHA256 (current through 2026). The count is stored in each
// hash, so raising the default later only needs ra_password_needs_rehash at
// the next successful login.

import "std/mem";
import "std/conv";
import "status";
import "encode";
import "hmac";
import "random";

/// Iterations used when ra_password_hash is given 0. The 2026 recommendation (OWASP).
export const RA_PASSWORD_ITER_DEFAULT: int64 = 600000;
/// Lowest count ra_password_hash accepts (for tests; production passes 0).
export const RA_PASSWORD_ITER_FLOOR: int64 = 1000;
/// Highest count ra_password_verify accepts from a stored hash (bounds the CPU a bad record can cost).
export const RA_PASSWORD_ITER_MAX: int64 = 10000000;
/// Salt bytes made by ra_password_hash.
export const RA_PASSWORD_SALT_LEN: int32 = 16;

fn rap_put(t: RaText*, s: string) {
  memcpy(&t->bytes[t->len], s.chars, (int64)s.length);
  t->len = t->len + (int32)s.length;
}

fn rap_put_int(t: RaText*, v: int64) {
  var d: uint8[20];
  var n: int64 = 0;
  var x: int64 = v;
  while (x > 0 || n == 0) {
    d[n] = (uint8)(48 + x % 10);
    x = x / 10;
    n = n + 1;
  }
  while (n > 0) {
    n = n - 1;
    t->bytes[t->len] = d[n];
    t->len = t->len + 1;
  }
}

/// Hashes a password with a caller-supplied salt (deterministic).
///
/// in:      password    the password bytes (any length)
///          iterations  0 for RA_PASSWORD_ITER_DEFAULT, else FLOOR..MAX
///          salt, saltlen  8..64 bytes; use ra_password_hash for a random one
///          out         receives the encoded hash
/// returns: RA_OK, or RA_E_USAGE for a bad iteration count or salt length
/// owns:    writes out; no allocation
/// thread:  any
/// example:
///   ra_password_hash_with_salt("pw", 1000, &salt[0], 16, &enc);   // test vectors, migrations
export fn ra_password_hash_with_salt(password: string, iterations: int64, salt: uint8*, saltlen: int64, out: RaText*) -> int32 {
  out->len = 0;
  var iter: int64 = iterations;
  if (iter == 0) { iter = RA_PASSWORD_ITER_DEFAULT; }
  if (iter < RA_PASSWORD_ITER_FLOOR || iter > RA_PASSWORD_ITER_MAX) { return RA_E_USAGE; }
  if (saltlen < 8 || saltlen > 64) { return RA_E_USAGE; }
  var dk: uint8[32];
  var rc: int32 = ra_pbkdf2_sha256(password.chars, (int64)password.length, salt, saltlen, iter, &dk[0], 32);
  if (rc != RA_OK) { return rc; }
  rap_put(out, "pbkdf2-sha256$");
  rap_put_int(out, iter);
  rap_put(out, "$");
  out->len = out->len + (int32)ra_b64url_encode(salt, saltlen, &out->bytes[out->len]);
  rap_put(out, "$");
  out->len = out->len + (int32)ra_b64url_encode(&dk[0], 32, &out->bytes[out->len]);
  memset(&dk[0], 0, 32);
  return RA_OK;
}

/// Hashes a password with a fresh random 16-byte salt.
///
/// in:      password    the password bytes
///          iterations  0 for RA_PASSWORD_ITER_DEFAULT (recommended), else FLOOR..MAX
///          out         receives the encoded hash; store ra_text_str(out)
/// returns: RA_OK, RA_E_USAGE (bad count), RA_E_IO / RA_E_UNSUPPORTED (no random source)
/// owns:    writes out; no allocation
/// thread:  any
/// example:
///   var enc: RaText;
///   if (ra_password_hash(pw, 0, &enc) != RA_OK) { return 500; }
///   db_save_user(name, ra_text_str(&enc));
export fn ra_password_hash(password: string, iterations: int64, out: RaText*) -> int32 {
  out->len = 0;
  var salt: uint8[16];
  var rc: int32 = ra_random_bytes(&salt[0], 16);
  if (rc != RA_OK) { return rc; }
  return ra_password_hash_with_salt(password, iterations, &salt[0], 16, out);
}

// The parts of an encoded hash.
struct RapParsed {
  iter: int64;
  salt: uint8[64];
  saltlen: int64;
  dk: uint8[32];
}

fn rap_parse(enc: string, p: RapParsed*) -> int32 {
  var prefix: string = "pbkdf2-sha256$";
  var n: int64 = (int64)enc.length;
  var pl: int64 = (int64)prefix.length;
  if (n < pl || n > 200) { return RA_E_INVALID; }
  if (memcmp(enc.chars, prefix.chars, pl) != 0) { return RA_E_INVALID; }
  var i: int64 = pl;
  var iter: int64 = 0;
  var digits: int64 = 0;
  while (i < n && enc.chars[i] != (uint8)36) {
    var c: int32 = (int32)enc.chars[i];
    if (c < 48 || c > 57 || digits >= 9) { return RA_E_INVALID; }
    iter = iter * 10 + (int64)(c - 48);
    digits = digits + 1;
    i = i + 1;
  }
  if (digits == 0 || i >= n) { return RA_E_INVALID; }
  if (iter < 1 || iter > RA_PASSWORD_ITER_MAX) { return RA_E_INVALID; }
  i = i + 1;
  var s0: int64 = i;
  while (i < n && enc.chars[i] != (uint8)36) { i = i + 1; }
  if (i >= n) { return RA_E_INVALID; }
  var salt_len: int64 = i - s0;
  if (salt_len < 11 || salt_len > 86) { return RA_E_INVALID; }
  var st: string = str_from_bytes((cstring)&enc.chars[s0], salt_len);
  var sl: int64 = ra_b64url_decode(st, &p->salt[0]);
  if (sl < 8) { return RA_E_INVALID; }
  var h0: int64 = i + 1;
  if (n - h0 != 43) { return RA_E_INVALID; }
  var ht: string = str_from_bytes((cstring)&enc.chars[h0], 43);
  if (ra_b64url_decode(ht, &p->dk[0]) != 32) { return RA_E_INVALID; }
  p->iter = iter;
  p->saltlen = sl;
  return RA_OK;
}

/// Checks a password against an encoded hash, comparing in constant time.
///
/// in:      password    what the user typed
///          encoded     a string from ra_password_hash (any iteration count <= MAX)
/// returns: RA_OK on a match, RA_E_MISMATCH on a wrong password,
///          RA_E_INVALID when encoded is not a raize_auth hash
/// owns:    reads both; no allocation
/// thread:  any
/// example:
///   var rc: int32 = ra_password_verify(pw, user.hash);
///   if (rc != RA_OK) { ra_lockout_fail(&auth, &policy, name, now); return 401; }
export fn ra_password_verify(password: string, encoded: string) -> int32 {
  var p: RapParsed;
  var rc: int32 = rap_parse(encoded, &p);
  if (rc != RA_OK) { return rc; }
  var dk: uint8[32];
  rc = ra_pbkdf2_sha256(password.chars, (int64)password.length, &p.salt[0], p.saltlen, p.iter, &dk[0], 32);
  if (rc != RA_OK) { return RA_E_INVALID; }
  var same: bool = ra_ct_equal(&dk[0], &p.dk[0], 32);
  memset(&dk[0], 0, 32);
  if (same) { return RA_OK; }
  return RA_E_MISMATCH;
}

/// Burns the time of one verify at the default count, for unknown user names,
/// so a login form does not reveal which names exist.
///
/// in:      password    what was typed
/// returns: RA_E_MISMATCH, always
/// owns:    nothing
/// thread:  any
/// example:
///   if (!found) { ra_password_verify_dummy(pw); return 401; }
export fn ra_password_verify_dummy(password: string) -> int32 {
  var salt: uint8[16];
  memset(&salt[0], 0x5a, 16);
  var dk: uint8[32];
  var _rc: int32 = ra_pbkdf2_sha256(password.chars, (int64)password.length, &salt[0], 16, RA_PASSWORD_ITER_DEFAULT, &dk[0], 32);
  return RA_E_MISMATCH;
}

/// Says whether a stored hash should be replaced (after a successful verify).
///
/// in:      encoded     a stored hash
///          iterations  the count you want now (0 = RA_PASSWORD_ITER_DEFAULT)
/// returns: true when encoded is malformed or uses fewer iterations
/// owns:    reads only
/// thread:  any
/// example:
///   if (ra_password_needs_rehash(user.hash, 0)) { ra_password_hash(pw, 0, &enc); save(...); }
export fn ra_password_needs_rehash(encoded: string, iterations: int64) -> bool {
  var want: int64 = iterations;
  if (want == 0) { want = RA_PASSWORD_ITER_DEFAULT; }
  var p: RapParsed;
  if (rap_parse(encoded, &p) != RA_OK) { return true; }
  return p.iter < want;
}

// Round-trip and known-answer tests run in tests/vectors: 1000 PBKDF2
// iterations exceed the @test interpreter's fixed step budget (reports/004).

@test fn t_ra_password_rejects() -> int32 {
  var salt: uint8[16];
  var enc: RaText;
  if (ra_password_hash_with_salt("x", 999, &salt[0], 16, &enc) != RA_E_USAGE) { return 1; }
  if (ra_password_hash_with_salt("x", 1000, &salt[0], 4, &enc) != RA_E_USAGE) { return 2; }
  if (ra_password_verify("x", "") != RA_E_INVALID) { return 3; }
  if (ra_password_verify("x", "bcrypt$10$abc") != RA_E_INVALID) { return 4; }
  if (ra_password_verify("x", "pbkdf2-sha256$99999999$c2FsdHNhbHQ$E196ZhRPzw-wA84EjzHwJO1cv_MFJdO6C_sxmUeTYqY") != RA_E_INVALID) { return 5; }
  if (ra_password_verify("x", "pbkdf2-sha256$1000$c2FsdHNhbHQ$short") != RA_E_INVALID) { return 6; }
  return 0;
}
