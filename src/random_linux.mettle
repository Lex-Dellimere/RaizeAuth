// raize_auth/random_linux: the getrandom(2) system call (x86-64 number 318).
// Internal to raize_auth; use ra_random_bytes from "random".
// thread: any; the kernel call is thread-safe.

/// Fills p[0..n] from getrandom(2), retrying short reads and EINTR.
///
/// in:      p, n     the buffer
/// returns: 0 on success, -1 when the kernel call fails (ENOSYS, EFAULT, ...)
/// owns:    writes p only
/// thread:  any
/// example:
///   if (rax_os_random(&b[0], 32) != 0) { return RA_E_IO; }
export fn rax_os_random(p: uint8*, n: int64) -> int32 {
  var done: int64 = 0;
  while (done < n) {
    var want: int64 = n - done;
    if (want > 256) { want = 256; }
    var got: int64 = syscall(318, &p[done], want, 0);
    if (got == -4) { continue; }
    if (got <= 0) { return -1; }
    done = done + got;
  }
  return 0;
}
