// raize_auth/status: the status vocabulary every fallible raize_auth call returns.
// thread: constants and pure functions; safe on any thread.
//
// RA_OK is 0 and every error is negative (the raize convention). The first
// nine codes line up with raize_web's RZ_E_* so an adapter can pass them on.

/// Success.
export const RA_OK: int32 = 0;
/// Misuse: a null handle, a buffer too small, a call in the wrong order.
export const RA_E_USAGE: int32 = -1;
/// Malformed input (a bad encoded hash, bad base64, an empty key).
export const RA_E_INVALID: int32 = -2;
/// No record for that token, code or key.
export const RA_E_NOT_FOUND: int32 = -3;
/// A record with that key already exists.
export const RA_E_CONFLICT: int32 = -4;
/// A fixed capacity is exhausted (a store or a buffer).
export const RA_E_FULL: int32 = -5;
/// An allocation failed.
export const RA_E_NOMEM: int32 = -6;
/// The operation is not supported (platform without getrandom, store without it).
export const RA_E_UNSUPPORTED: int32 = -7;
/// The store failed for its own reasons (a MeoSQL error, a closed store).
export const RA_E_STORE: int32 = -8;
/// The OS random source failed.
export const RA_E_IO: int32 = -9;
/// The session, token or device code has expired.
export const RA_E_EXPIRED: int32 = -10;
/// The session or token was revoked.
export const RA_E_REVOKED: int32 = -11;
/// Wrong password, wrong CSRF token, or a token of the wrong kind.
export const RA_E_MISMATCH: int32 = -12;
/// The lockout key is locked after too many failures.
export const RA_E_LOCKED: int32 = -13;
/// The API token's scope does not cover what was asked.
export const RA_E_SCOPE: int32 = -14;
/// Device flow: the user has not approved yet; poll again after the interval.
export const RA_E_PENDING: int32 = -15;
/// Device flow: polled faster than the interval; the interval grew by 5 s.
export const RA_E_SLOW_DOWN: int32 = -16;
/// Device flow: the user denied the request.
export const RA_E_DENIED: int32 = -17;
/// The crypto library failed or was not initialised (call cr_init first).
export const RA_E_CRYPTO: int32 = -18;

/// Names a status in a few words, for logs and error messages.
///
/// in:      code     RA_OK or any RA_E_* value
/// returns: a short lowercase phrase; "unknown status" for any other value
/// owns:    the result is a static string; never free it
/// thread:  any
/// example:
///   println("login: {ra_status_text(rc)}");
export fn ra_status_text(code: int32) -> string {
  if (code == RA_OK) { return "ok"; }
  if (code == RA_E_USAGE) { return "misuse"; }
  if (code == RA_E_INVALID) { return "invalid input"; }
  if (code == RA_E_NOT_FOUND) { return "not found"; }
  if (code == RA_E_CONFLICT) { return "conflict"; }
  if (code == RA_E_FULL) { return "capacity exhausted"; }
  if (code == RA_E_NOMEM) { return "out of memory"; }
  if (code == RA_E_UNSUPPORTED) { return "unsupported"; }
  if (code == RA_E_STORE) { return "store error"; }
  if (code == RA_E_IO) { return "random source failed"; }
  if (code == RA_E_EXPIRED) { return "expired"; }
  if (code == RA_E_REVOKED) { return "revoked"; }
  if (code == RA_E_MISMATCH) { return "mismatch"; }
  if (code == RA_E_LOCKED) { return "locked"; }
  if (code == RA_E_SCOPE) { return "scope not allowed"; }
  if (code == RA_E_PENDING) { return "authorization pending"; }
  if (code == RA_E_SLOW_DOWN) { return "slow down"; }
  if (code == RA_E_DENIED) { return "access denied"; }
  if (code == RA_E_CRYPTO) { return "crypto failure"; }
  return "unknown status";
}

@test fn t_ra_status_codes() -> int32 {
  if (RA_OK != 0 || RA_E_USAGE != -1 || RA_E_DENIED != -17) { return 1; }
  if (ra_status_text(RA_E_LOCKED) != "locked") { return 2; }
  if (ra_status_text(99) != "unknown status") { return 3; }
  return 0;
}
