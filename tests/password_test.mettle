// tests/password_test: ra_password_* over crypto's Argon2id. A test program
// (Argon2id is too slow for the @test interpreter); `mbuild test`
// builds and runs it, `mbuild test -r` in release.

import "std/io";
import "raize_auth/auth";

var g_fail: int32 = 0;

fn check(name: string, ok: bool) {
  if (!ok) {
    g_fail = g_fail + 1;
    println("FAIL " + name);
  }
}

fn main() -> int32 {
  if (cr_init() != CR_OK) { println("FAIL cr_init"); return 1; }

  check("policy short", !ra_password_ok("1234567"));
  check("policy min", ra_password_ok("12345678"));

  var h: CrPwHash;
  check("hash short is invalid", ra_password_hash(&h, "short", CR_PW_INTERACTIVE) == RA_E_INVALID);
  check("hash null out", ra_password_hash((CrPwHash*)0, "correct horse", CR_PW_INTERACTIVE) == RA_E_USAGE);
  check("hash ok", ra_password_hash(&h, "correct horse", CR_PW_INTERACTIVE) == RA_OK);
  check("verify right", ra_password_verify(&h, "correct horse"));
  check("verify wrong", !ra_password_verify(&h, "correct horsf"));
  check("verify too short", !ra_password_verify(&h, "short"));
  check("verify null hash", !ra_password_verify((CrPwHash*)0, "correct horse"));
  check("no rehash at same preset", !ra_password_needs_rehash(&h, CR_PW_INTERACTIVE));
  check("rehash at stronger preset", ra_password_needs_rehash(&h, CR_PW_MODERATE));

  // Store as text, load back, verify again.
  var text: string = ra_password_text(&h);
  check("text is argon2id", text.length > 10 && text.chars[0] == (uint8)36);
  var h2: CrPwHash;
  check("from_text ok", ra_password_from_text(&h2, text) == RA_OK);
  check("verify after reload", ra_password_verify(&h2, "correct horse"));
  var bad: CrPwHash;
  check("from_text rejects junk", ra_password_from_text(&bad, "plaintext") == RA_E_INVALID);
  check("from_text rejects empty", ra_password_from_text(&bad, "") == RA_E_INVALID);

  // Two hashes of one password differ (random salt).
  var h3: CrPwHash;
  check("hash again", ra_password_hash(&h3, "correct horse", CR_PW_INTERACTIVE) == RA_OK);
  check("salted", ra_password_text(&h3) != ra_password_text(&h));

  check("status name", ra_status_text(RA_E_CRYPTO) == "crypto failure");

  if (g_fail != 0) { println("password: {g_fail} failed"); return 1; }
  println("OK password");
  return 0;
}
