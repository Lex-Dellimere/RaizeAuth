// tests/store_test: the store contracts (src/store.mettle) exercised through
// the public ra_store_* / ra_token_* wrappers over a test-only in-memory
// backend. A test program; `mbuild test` builds and runs it, `-r` in release.

import "std/io";
import "std/mem";
import "raize_auth/auth";
import "teststore";

var g_fail: int32 = 0;

fn check(name: string, ok: bool) {
  if (!ok) {
    g_fail = g_fail + 1;
    println("FAIL " + name);
  }
}

// ---- helpers ----

// Fills a token with the SHA-256 of `secret` as its key.
fn tst_make_token(t: RaToken*, secret: string, owner: int64) {
  memset((rawptr)t, 0, (int64)sizeof(RaToken));
  var h: CrSha256;
  cr_token_hash(&h, secret);
  memcpy((rawptr)&t->key[0], (rawptr)&h.b[0], 32);
  t->owner = owner;
}

fn tst_key_of(out: CrSha256*, secret: string) {
  cr_token_hash(out, secret);
}

fn main() -> int32 {
  if (cr_init() != CR_OK) { println("FAIL cr_init"); return 1; }

  var db: TstDb;
  tst_init(&db);
  var stores: RaStores;
  var cst: RaCredStore;
  var kst: RaCounterStore;
  var tst: RaTokenStore;
  tst_bind(&stores, &cst, &kst, &tst, &db);

  // ---- completeness ----
  var zc: RaCredStore;
  var zk: RaCounterStore;
  var zt: RaTokenStore;
  memset((rawptr)&zc, 0, (int64)sizeof(RaCredStore));
  memset((rawptr)&zk, 0, (int64)sizeof(RaCounterStore));
  memset((rawptr)&zt, 0, (int64)sizeof(RaTokenStore));
  check("cred zeroed incomplete", !ra_store_cred_complete(&zc));
  check("ctr zeroed incomplete", !ra_store_ctr_complete(&zk));
  check("tok zeroed incomplete", !ra_store_tok_complete(&zt));
  check("cred complete after bind", ra_store_cred_complete(&cst));
  check("ctr complete after bind", ra_store_ctr_complete(&kst));
  check("tok complete after bind", ra_store_tok_complete(&tst));
  check("stores point at them", stores.creds == &cst && stores.counters == &kst && stores.tokens == &tst);
  var probe: RaToken;
  check("incomplete tok_put is USAGE", ra_store_tok_put(&zt, &probe) == RA_E_USAGE);
  var pcred: RaCredential;
  check("incomplete cred_get is USAGE", ra_store_cred_get(&zc, "ada", &pcred) == RA_E_USAGE);
  var pctr: RaCounter;
  check("incomplete ctr_put is USAGE", ra_store_ctr_put(&zk, &pctr) == RA_E_USAGE);
  check("incomplete ctr_prune is USAGE", ra_store_ctr_prune(&zk, 0, 0) == RA_E_USAGE);
  check("incomplete tok_prune is USAGE", ra_store_tok_prune(&zt, 0) == RA_E_USAGE);

  // ---- tokens ----
  var t1: RaToken;
  var t2: RaToken;
  var t3: RaToken;
  tst_make_token(&t1, "rat_test1", 1);
  tst_make_token(&t2, "rat_test2", 1);
  tst_make_token(&t3, "rat_test3", 2);
  check("scope t1", ra_token_set_scope(&t1, "publish yank") == RA_OK);
  check("label t1", ra_token_set_label(&t1, "CI publish") == RA_OK);
  check("scope t2", ra_token_set_scope(&t2, "read") == RA_OK);
  check("label t2", ra_token_set_label(&t2, "laptop") == RA_OK);
  check("scope t3", ra_token_set_scope(&t3, "admin") == RA_OK);
  check("label t3", ra_token_set_label(&t3, "bob token") == RA_OK);
  check("put t1", ra_store_tok_put(&tst, &t1) == RA_OK);
  check("put t2", ra_store_tok_put(&tst, &t2) == RA_OK);
  check("put t3", ra_store_tok_put(&tst, &t3) == RA_OK);

  var got: RaToken;
  check("get t1", ra_store_tok_get(&tst, &t1.key[0], &got) == RA_OK);
  check("get t1 owner", got.owner == 1);
  check("get t1 scope", ra_token_scope(&got) == "publish yank");
  check("get t1 label", ra_token_label(&got) == "CI publish");
  var got3: RaToken;
  check("get t3", ra_store_tok_get(&tst, &t3.key[0], &got3) == RA_OK);
  check("get t3 owner", got3.owner == 2);
  check("get t3 scope", ra_token_scope(&got3) == "admin");

  var unknown: CrSha256;
  tst_key_of(&unknown, "rat_unknown");
  var miss: RaToken;
  check("get unknown", ra_store_tok_get(&tst, &unknown.b[0], &miss) == RA_E_NOT_FOUND);

  var page: RaToken[4];
  check("list owner 1 count", ra_store_tok_list(&tst, 1, 0, &page[0], 4) == 2);
  check("list owner 2 count", ra_store_tok_list(&tst, 2, 0, &page[0], 4) == 1);
  check("list unknown owner", ra_store_tok_list(&tst, 77, 0, &page[0], 4) == 0);

  // put of the same key replaces; count stays the same.
  var t1b: RaToken;
  tst_make_token(&t1b, "rat_test1", 1);
  check("scope t1b", ra_token_set_scope(&t1b, "publish") == RA_OK);
  check("label t1b", ra_token_set_label(&t1b, "renamed") == RA_OK);
  check("put t1 again", ra_store_tok_put(&tst, &t1b) == RA_OK);
  check("list after replace", ra_store_tok_list(&tst, 1, 0, &page[0], 4) == 2);
  var got1b: RaToken;
  check("get replaced", ra_store_tok_get(&tst, &t1.key[0], &got1b) == RA_OK);
  check("replaced scope", ra_token_scope(&got1b) == "publish");
  check("replaced label", ra_token_label(&got1b) == "renamed");

  // ---- tok_list paging ----
  var one: RaToken[1];
  check("page cap1 skip0", ra_store_tok_list(&tst, 1, 0, &one[0], 1) == 1);
  check("page cap1 skip1", ra_store_tok_list(&tst, 1, 1, &one[0], 1) == 1);
  check("page cap1 skip2", ra_store_tok_list(&tst, 1, 2, &one[0], 1) == 0);
  check("list cap 0 is USAGE", ra_store_tok_list(&tst, 1, 0, &one[0], 0) == RA_E_USAGE);
  check("list skip -1 is USAGE", ra_store_tok_list(&tst, 1, -1, &one[0], 1) == RA_E_USAGE);

  // ---- delete ----
  check("del t2", ra_store_tok_del(&tst, &t2.key[0]) == RA_OK);
  check("get after del", ra_store_tok_get(&tst, &t2.key[0], &miss) == RA_E_NOT_FOUND);
  check("del again", ra_store_tok_del(&tst, &t2.key[0]) == RA_E_NOT_FOUND);
  check("list after del", ra_store_tok_list(&tst, 1, 0, &page[0], 4) == 1);

  // ---- counters ----
  var ck: CrSha256;
  tst_key_of(&ck, "login:ada");
  var c: RaCounter;
  memcpy((rawptr)&c.key[0], (rawptr)&ck.b[0], 32);
  c.failures = 3;
  c.window_start = 1000;
  c.locked_until = 2000;
  check("ctr put", ra_store_ctr_put(&kst, &c) == RA_OK);
  var cg: RaCounter;
  check("ctr get", ra_store_ctr_get(&kst, &ck.b[0], &cg) == RA_OK);
  check("ctr failures", cg.failures == 3);
  check("ctr window_start", cg.window_start == 1000);
  check("ctr locked_until", cg.locked_until == 2000);
  c.failures = 4;
  check("ctr put replace", ra_store_ctr_put(&kst, &c) == RA_OK);
  check("ctr get replaced", ra_store_ctr_get(&kst, &ck.b[0], &cg) == RA_OK && cg.failures == 4);
  check("ctr del", ra_store_ctr_del(&kst, &ck.b[0]) == RA_OK);
  check("ctr get after del", ra_store_ctr_get(&kst, &ck.b[0], &cg) == RA_E_NOT_FOUND);
  check("ctr del again", ra_store_ctr_del(&kst, &ck.b[0]) == RA_E_NOT_FOUND);

  // ---- credentials ----
  var cred: RaCredential;
  check("cred ada", ra_store_cred_get(&cst, "ada", &cred) == RA_OK);
  check("cred ada owner", cred.owner == 1);
  check("cred ada enabled", cred.disabled == 0);
  var cred_bob: RaCredential;
  check("cred bob", ra_store_cred_get(&cst, "bob", &cred_bob) == RA_OK);
  check("cred bob owner", cred_bob.owner == 2);
  check("cred bob disabled", cred_bob.disabled == 1);
  check("cred nobody", ra_store_cred_get(&cst, "nobody", &cred) == RA_E_NOT_FOUND);
  check("cred empty login", ra_store_cred_get(&cst, "", &cred) == RA_E_USAGE);

  var h: CrPwHash;
  check("hash pw", ra_password_hash(&h, "correct horse", CR_PW_INTERACTIVE) == RA_OK);
  check("set_hash owner 1", ra_store_cred_set_hash(&cst, 1, &h) == RA_OK);
  var cred2: RaCredential;
  check("cred ada again", ra_store_cred_get(&cst, "ada", &cred2) == RA_OK);
  check("cred owner kept", cred2.owner == 1);
  check("stored hash verifies", ra_password_verify(&cred2.hash, "correct horse"));
  check("stored hash rejects wrong", !ra_password_verify(&cred2.hash, "correct horsf"));
  check("set_hash owner 99", ra_store_cred_set_hash(&cst, 99, &h) == RA_E_NOT_FOUND);

  // ---- prune (fresh store so the count is exact) ----
  var db2: TstDb;
  tst_init(&db2);
  var stores2: RaStores;
  var cst2: RaCredStore;
  var kst2: RaCounterStore;
  var tst2: RaTokenStore;
  tst_bind(&stores2, &cst2, &kst2, &tst2, &db2);
  var now: int64 = 1000000;

  var pr: RaToken;
  tst_make_token(&pr, "rat_revoked", 1);
  pr.revoked = 1;
  check("prune put revoked", ra_store_tok_put(&tst2, &pr) == RA_OK);
  var pe: RaToken;
  tst_make_token(&pe, "rat_expired", 1);
  pe.expires = now - 1;
  check("prune put expired", ra_store_tok_put(&tst2, &pe) == RA_OK);
  var pl: RaToken;
  tst_make_token(&pl, "rat_live", 1);
  pl.expires = 0;
  check("prune put live", ra_store_tok_put(&tst2, &pl) == RA_OK);

  var sk: CrSha256;
  tst_key_of(&sk, "stale");
  var cs: RaCounter;
  memcpy((rawptr)&cs.key[0], (rawptr)&sk.b[0], 32);
  cs.failures = 2;
  cs.window_start = now - 5000;
  cs.locked_until = 0;
  check("prune put stale ctr", ra_store_ctr_put(&kst2, &cs) == RA_OK);
  var lk: CrSha256;
  tst_key_of(&lk, "locked");
  var cl: RaCounter;
  memcpy((rawptr)&cl.key[0], (rawptr)&lk.b[0], 32);
  cl.failures = 9;
  cl.window_start = now - 5000;
  cl.locked_until = now + 100;
  check("prune put locked ctr", ra_store_ctr_put(&kst2, &cl) == RA_OK);

  check("tok prune removes 2", ra_store_tok_prune(&tst2, now) == 2);
  check("ctr prune removes 1", ra_store_ctr_prune(&kst2, now, now) == 1);
  var chk: RaToken;
  check("prune keeps live token", ra_store_tok_get(&tst2, &pl.key[0], &chk) == RA_OK);
  check("prune dropped revoked", ra_store_tok_get(&tst2, &pr.key[0], &chk) == RA_E_NOT_FOUND);
  check("prune dropped expired", ra_store_tok_get(&tst2, &pe.key[0], &chk) == RA_E_NOT_FOUND);
  var cchk: RaCounter;
  check("prune keeps locked ctr", ra_store_ctr_get(&kst2, &lk.b[0], &cchk) == RA_OK);
  check("prune dropped stale ctr", ra_store_ctr_get(&kst2, &sk.b[0], &cchk) == RA_E_NOT_FOUND);
  check("tok prune again removes none", ra_store_tok_prune(&tst2, now) == 0);
  check("ctr prune again removes none", ra_store_ctr_prune(&kst2, now, now) == 0);

  if (g_fail != 0) { println("store: {g_fail} failed"); return 1; }
  println("OK store");
  return 0;
}
