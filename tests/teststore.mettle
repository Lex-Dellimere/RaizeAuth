// tests/teststore: TEST-ONLY in-memory RaStore shared by the test programs
// (store_test, login_test). Not part of the library. It has no fn main, so
// mbuild does not treat it as a test program. Credential slots are fixed:
// "ada" (owner 1, enabled) and "bob" (owner 2, disabled), both without a hash
// until ra_store_cred_set_hash / ra_set_password gives them one.

import "std/mem";
import "raize_auth/auth";

export struct TstDb {
  tokens: RaToken[16];
  tok_used: int32[16];
  counters: RaCounter[8];
  ctr_used: int32[8];
  creds: RaCredential[2];
}

export fn tst_init(db: TstDb*) {
  memset((rawptr)db, 0, (int64)sizeof(TstDb));
  db->creds[0].owner = 1;
  db->creds[0].disabled = 0;
  db->creds[1].owner = 2;
  db->creds[1].disabled = 1;
}

fn tst_tok_find(db: TstDb*, key: uint8*) -> int32 {
  var i: int32 = 0;
  while (i < 16) {
    if (db->tok_used[i] != 0 && memcmp((rawptr)&db->tokens[i].key[0], (rawptr)key, 32) == 0) { return i; }
    i = i + 1;
  }
  return -1;
}

fn tst_ctr_find(db: TstDb*, key: uint8*) -> int32 {
  var i: int32 = 0;
  while (i < 8) {
    if (db->ctr_used[i] != 0 && memcmp((rawptr)&db->counters[i].key[0], (rawptr)key, 32) == 0) { return i; }
    i = i + 1;
  }
  return -1;
}

fn tst_tok_put(ctx: rawptr, r: RaToken*) -> int32 {
  var db: TstDb* = (TstDb*)ctx;
  var i: int32 = tst_tok_find(db, &r->key[0]);
  if (i < 0) {
    var j: int32 = 0;
    while (j < 16) {
      if (db->tok_used[j] == 0) { i = j; break; }
      j = j + 1;
    }
  }
  if (i < 0) { return RA_E_FULL; }
  memcpy((rawptr)&db->tokens[i], (rawptr)r, (int64)sizeof(RaToken));
  db->tok_used[i] = 1;
  return RA_OK;
}

fn tst_tok_get(ctx: rawptr, key: uint8*, out: RaToken*) -> int32 {
  var db: TstDb* = (TstDb*)ctx;
  var i: int32 = tst_tok_find(db, key);
  if (i < 0) { return RA_E_NOT_FOUND; }
  memcpy((rawptr)out, (rawptr)&db->tokens[i], (int64)sizeof(RaToken));
  return RA_OK;
}

fn tst_tok_del(ctx: rawptr, key: uint8*) -> int32 {
  var db: TstDb* = (TstDb*)ctx;
  var i: int32 = tst_tok_find(db, key);
  if (i < 0) { return RA_E_NOT_FOUND; }
  db->tok_used[i] = 0;
  memset((rawptr)&db->tokens[i], 0, (int64)sizeof(RaToken));
  return RA_OK;
}

fn tst_tok_list(ctx: rawptr, owner: int64, skip: int64, out: RaToken*, cap: int32) -> int32 {
  var db: TstDb* = (TstDb*)ctx;
  var seen: int64 = 0;
  var n: int32 = 0;
  var i: int32 = 0;
  while (i < 16 && n < cap) {
    if (db->tok_used[i] != 0 && db->tokens[i].owner == owner) {
      if (seen >= skip) {
        memcpy((rawptr)&out[n], (rawptr)&db->tokens[i], (int64)sizeof(RaToken));
        n = n + 1;
      }
      seen = seen + 1;
    }
    i = i + 1;
  }
  return n;
}

fn tst_ctr_get(ctx: rawptr, key: uint8*, out: RaCounter*) -> int32 {
  var db: TstDb* = (TstDb*)ctx;
  var i: int32 = tst_ctr_find(db, key);
  if (i < 0) { return RA_E_NOT_FOUND; }
  memcpy((rawptr)out, (rawptr)&db->counters[i], (int64)sizeof(RaCounter));
  return RA_OK;
}

fn tst_ctr_put(ctx: rawptr, r: RaCounter*) -> int32 {
  var db: TstDb* = (TstDb*)ctx;
  var i: int32 = tst_ctr_find(db, &r->key[0]);
  if (i < 0) {
    var j: int32 = 0;
    while (j < 8) {
      if (db->ctr_used[j] == 0) { i = j; break; }
      j = j + 1;
    }
  }
  if (i < 0) { return RA_E_FULL; }
  memcpy((rawptr)&db->counters[i], (rawptr)r, (int64)sizeof(RaCounter));
  db->ctr_used[i] = 1;
  return RA_OK;
}

fn tst_ctr_del(ctx: rawptr, key: uint8*) -> int32 {
  var db: TstDb* = (TstDb*)ctx;
  var i: int32 = tst_ctr_find(db, key);
  if (i < 0) { return RA_E_NOT_FOUND; }
  db->ctr_used[i] = 0;
  memset((rawptr)&db->counters[i], 0, (int64)sizeof(RaCounter));
  return RA_OK;
}

fn tst_cred_slot(login: string) -> int32 {
  if (login == "ada") { return 0; }
  if (login == "bob") { return 1; }
  return -1;
}

fn tst_cred_get(ctx: rawptr, login: string, out: RaCredential*) -> int32 {
  var db: TstDb* = (TstDb*)ctx;
  var i: int32 = tst_cred_slot(login);
  if (i < 0) { return RA_E_NOT_FOUND; }
  memcpy((rawptr)out, (rawptr)&db->creds[i], (int64)sizeof(RaCredential));
  return RA_OK;
}

fn tst_cred_set_hash(ctx: rawptr, owner: int64, h: CrPwHash*) -> int32 {
  var db: TstDb* = (TstDb*)ctx;
  var i: int32 = 0;
  while (i < 2) {
    if (db->creds[i].owner == owner) {
      memcpy((rawptr)&db->creds[i].hash, (rawptr)h, (int64)sizeof(CrPwHash));
      return RA_OK;
    }
    i = i + 1;
  }
  return RA_E_NOT_FOUND;
}

fn tst_prune(ctx: rawptr, now: int64, counter_before: int64) -> int32 {
  var db: TstDb* = (TstDb*)ctx;
  var removed: int32 = 0;
  var i: int32 = 0;
  while (i < 16) {
    if (db->tok_used[i] != 0) {
      var t: RaToken* = &db->tokens[i];
      if (t->revoked != 0 || (t->expires > 0 && t->expires <= now)) {
        db->tok_used[i] = 0;
        memset((rawptr)t, 0, (int64)sizeof(RaToken));
        removed = removed + 1;
      }
    }
    i = i + 1;
  }
  i = 0;
  while (i < 8) {
    if (db->ctr_used[i] != 0) {
      var c: RaCounter* = &db->counters[i];
      if (c->locked_until <= now && c->window_start < counter_before) {
        db->ctr_used[i] = 0;
        memset((rawptr)c, 0, (int64)sizeof(RaCounter));
        removed = removed + 1;
      }
    }
    i = i + 1;
  }
  return removed;
}

export fn tst_bind(st: RaStore*, db: TstDb*) {
  st->ctx = (rawptr)db;
  st->tok_put = &tst_tok_put;
  st->tok_get = &tst_tok_get;
  st->tok_del = &tst_tok_del;
  st->tok_list = &tst_tok_list;
  st->ctr_get = &tst_ctr_get;
  st->ctr_put = &tst_ctr_put;
  st->ctr_del = &tst_ctr_del;
  st->cred_get = &tst_cred_get;
  st->cred_set_hash = &tst_cred_set_hash;
  st->prune = &tst_prune;
}
