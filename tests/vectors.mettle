// tests/vectors: every published crypto vector, compiled (debug and --release),
// plus the getrandom source, which the @test interpreter cannot run.
// Run with `mbuild test-programs`.

import "std/io";
import "std/mem";
import "raize_auth/auth";

var g_pass: int32 = 0;
var g_fail: int32 = 0;

fn check(name: string, ok: bool) {
  if (ok) {
    g_pass = g_pass + 1;
  } else {
    g_fail = g_fail + 1;
    println("FAIL " + name);
  }
}

fn hex_is(d: uint8*, n: int64, want: string) -> bool {
  var hex: uint8[256];
  var m: int64 = ra_hex_encode(d, n, &hex[0]);
  if ((uint64)m != want.length) { return false; }
  return memcmp(&hex[0], want.chars, m) == 0;
}

fn sha_is(s: string, want: string) -> bool {
  var d: uint8[32];
  ra_sha256_str(s, &d[0]);
  return hex_is(&d[0], 32, want);
}

fn hmac_is(key: uint8*, klen: int64, msg: string, want: string) -> bool {
  var tag: uint8[32];
  ra_hmac_sha256(key, klen, msg.chars, (int64)msg.length, &tag[0]);
  return hex_is(&tag[0], (int64)want.length / 2, want);
}

fn pbkdf2_is(pw: string, salt: string, c: int64, dklen: int64, want: string) -> bool {
  var dk: uint8[64];
  if (ra_pbkdf2_sha256(pw.chars, (int64)pw.length, salt.chars, (int64)salt.length, c, &dk[0], dklen) != RA_OK) { return false; }
  return hex_is(&dk[0], dklen, want);
}

fn sha256_vectors() {
  check("sha256 abc", sha_is("abc", "ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad"));
  check("sha256 empty", sha_is("", "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855"));
  check("sha256 448-bit", sha_is("abcdbcdecdefdefgefghfghighijhijkijkljklmklmnlmnomnopnopq", "248d6a61d20638b8e5c026930c3e6039a33ce45964ff2167f6ecedd419db06c1"));
  check("sha256 896-bit", sha_is("abcdefghbcdefghicdefghijdefghijkefghijklfghijklmghijklmnhijklmnoijklmnopjklmnopqklmnopqrlmnopqrsmnopqrstnopqrstu", "cf5b16a778af8380036ce59e7b0492370b249b11e8f07a51afac45037afee9d1"));
  var n: int64 = 1000000;
  var big: uint8* = (uint8*)malloc(n);
  memset(big, 97, n);
  var d: uint8[32];
  ra_sha256(big, n, &d[0]);
  check("sha256 1M a (one shot)", hex_is(&d[0], 32, "cdc76e5c9914fb9281a1c7e284d73e67f1809a48a497200e046d39ccc7112cd0"));
  var c: RaSha256;
  ra_sha256_init(&c);
  var off: int64 = 0;
  while (off < n) {
    ra_sha256_update(&c, &big[off], 1000);
    off = off + 1000;
  }
  ra_sha256_final(&c, &d[0]);
  check("sha256 1M a (streamed)", hex_is(&d[0], 32, "cdc76e5c9914fb9281a1c7e284d73e67f1809a48a497200e046d39ccc7112cd0"));
  free(big);
}

fn hmac_vectors() {
  var k: uint8[131];
  memset(&k[0], 0x0b, 20);
  check("rfc4231 1", hmac_is(&k[0], 20, "Hi There", "b0344c61d8db38535ca8afceaf0bf12b881dc200c9833da726e9376c2e32cff7"));
  var jefe: string = "Jefe";
  check("rfc4231 2", hmac_is(jefe.chars, 4, "what do ya want for nothing?", "5bdcc146bf60754e6a042426089575c75a003f089d2739839dec58b964ec3843"));
  memset(&k[0], 0xaa, 131);
  var dd: uint8[50];
  memset(&dd[0], 0xdd, 50);
  var tag: uint8[32];
  ra_hmac_sha256(&k[0], 20, &dd[0], 50, &tag[0]);
  check("rfc4231 3", hex_is(&tag[0], 32, "773ea91e36800e46854db8ebd09181a72959098b3ef8c122d9635514ced565fe"));
  var k4: uint8[25];
  for i in 0..25 { k4[i] = (uint8)(i + 1); }
  memset(&dd[0], 0xcd, 50);
  ra_hmac_sha256(&k4[0], 25, &dd[0], 50, &tag[0]);
  check("rfc4231 4", hex_is(&tag[0], 32, "82558a389a443c0ea4cc819899f2083a85f0faa3e578f8077a2e3ff46729665b"));
  var k5: uint8[20];
  memset(&k5[0], 0x0c, 20);
  check("rfc4231 5 (128-bit)", hmac_is(&k5[0], 20, "Test With Truncation", "a3b6167473100ee06e0c796c2955552b"));
  check("rfc4231 6", hmac_is(&k[0], 131, "Test Using Larger Than Block-Size Key - Hash Key First", "60e431591ee0b67f0d8a26aacbf5b77f8e0bc6213728c5140546040f0ee37f54"));
  check("rfc4231 7", hmac_is(&k[0], 131, "This is a test using a larger than block-size key and a larger than block-size data. The key needs to be hashed before being used by the HMAC algorithm.", "9b09ffa71b942fcb27635fbcd5b0e944bfdc63644f0713938a7f51535c3a35e2"));
}

fn pbkdf2_vectors() {
  check("pbkdf2 c=1", pbkdf2_is("password", "salt", 1, 32, "120fb6cffcf8b32c43e7225256c4f837a86548c92ccc35480805987cb70be17b"));
  check("pbkdf2 c=2", pbkdf2_is("password", "salt", 2, 32, "ae4d0c95af6b46d32d0adff928f06dd02a303f8ef3c251dfd6e2d85a95474c43"));
  check("pbkdf2 c=4096", pbkdf2_is("password", "salt", 4096, 32, "c5e478d59288c841aa530db6845c4c8d962893a001ce4e11a4963873aa98134a"));
  check("pbkdf2 long c=4096 dk=40", pbkdf2_is("passwordPASSWORDpassword", "saltSALTsaltSALTsaltSALTsaltSALTsalt", 4096, 40, "348c89dbcbd32b2f32d814b8116e84cf2b17347ebc1800181c4e2a1fb8dd53e1c635518c7dac47e9"));
  check("rfc7914 passwd c=1 dk=64", pbkdf2_is("passwd", "salt", 1, 64, "55ac046e56e3089fec1691c22544b605f94185216dde0465e68b9d57c20dacbc49ca9cccf179b645991664b39d77ef317c71b845b1e30bd509112041d3a19783"));
  check("rfc7914 Password/NaCl c=80000 dk=64", pbkdf2_is("Password", "NaCl", 80000, 64, "4ddcd8f60b98be21830cee5ef22701f9641a4418d04c0414aeff08876b34ab56a1d425a1225833549adb841b51c9b3176a272bdebba1d078478f62b397f33c8d"));
}

fn random_checks() {
  var a: uint8[32];
  var b: uint8[32];
  memset(&a[0], 0, 32);
  memset(&b[0], 0, 32);
  check("getrandom a", ra_random_bytes(&a[0], 32) == RA_OK);
  check("getrandom b", ra_random_bytes(&b[0], 32) == RA_OK);
  check("getrandom differs", !ra_ct_equal(&a[0], &b[0], 32));
  var zero: uint8[32];
  memset(&zero[0], 0, 32);
  check("getrandom not zero", !ra_ct_equal(&a[0], &zero[0], 32));
  var big: uint8* = (uint8*)malloc(4096);
  check("getrandom 4096", ra_random_bytes(big, 4096) == RA_OK);
  free(big);
  var enc: uint8[43];
  var n: int64 = ra_b64url_encode(&a[0], 32, &enc[0]);
  var back: uint8[32];
  var s: string = str_from_bytes((cstring)&enc[0], n);
  check("b64url roundtrip", n == 43 && ra_b64url_decode(s, &back[0]) == 32 && ra_ct_equal(&a[0], &back[0], 32));
}

fn main() -> int32 {
  sha256_vectors();
  hmac_vectors();
  pbkdf2_vectors();
  random_checks();
  println("vectors: {g_pass} passed, {g_fail} failed");
  if (g_fail != 0) { return 1; }
  return 0;
}
